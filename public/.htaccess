DirectoryIndex index.php

## ------------------------------
## Performance + Security Headers
## ------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # The Salla panel opens inside Salla's dashboard: its own frame-ancestors rule allows only Salla.
    SetEnvIf Request_URI "^/api/salla/panel/?$" BOTZO_SALLA_PANEL
    Header always set X-Frame-Options "SAMEORIGIN" env=!BOTZO_SALLA_PANEL
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

## ------------------------------
## Compression (when modules exist)
## ------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml application/rss+xml application/atom+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/plain text/html text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml application/rss+xml application/atom+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

## ------------------------------
## Static asset cache policy
## ------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType application/json "access plus 1 hour"

    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Rules match file names with <FilesMatch>: LiteSpeed ignores SetEnvIfExpr + "Header ... env=".

    # Build output is named by content (app-1a2b3c4d.js): cache it for good.
    <FilesMatch "-[0-9a-f]{8}\.(css|js|mjs|woff2?|ttf|otf|png|jpe?g|gif|svg|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset Expires
    </FilesMatch>

    <FilesMatch "^manifest\.json$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
        Header unset Expires
    </FilesMatch>

    # Website widget: customers embed the loader (/widget.js), so it is cached briefly and picks up
    # new versions; the widget itself (/widget/widget.<hash>.js) is named by content.
    <FilesMatch "^(salla-)?widget\.js$">
        Header set Cache-Control "public, max-age=300"
        Header unset Expires
    </FilesMatch>

    <FilesMatch "^widget\.[0-9a-f]{10}\.js$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset Expires
    </FilesMatch>

    # Translation files are named by their content (/i18n/ar.<hash>.json): cache them for good.
    <FilesMatch "^[a-z]{2}(_[a-z]{2})?\.[0-9a-f]{12}\.json$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset Expires
    </FilesMatch>

    # Keep compressed variants safe for shared caches.
    <FilesMatch "\.(css|js|mjs|map|json|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|otf)$">
        Header merge Vary "Accept-Encoding"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow ACME challenge without redirecting the challenge path.
    RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteRule ^$ index.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_dir.c>
    FallbackResource /index.php
</IfModule>
